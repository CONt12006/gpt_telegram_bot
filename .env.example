# Telegram bot token from @BotFather
TG_TOKEN=

# Any OpenAI-compatible provider (default: OpenRouter, has free models)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free

# Optional
SYSTEM_PROMPT=You are a helpful assistant. Answer concisely.
MAX_HISTORY=20
# Comma-separated Telegram user IDs; empty = everyone can use the bot
ALLOWED_USERS=
